{
  "name": "@agentproof/sdk",
  "version": "0.1.1",
  "description": "Verifiable safety runtime for autonomous agents: policy evaluation off-chain, enforcement at the wallet boundary.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./calldata": "./src/testing/calldata.ts",
    "./decode/uniswap": "./src/decode/uniswapV4.ts",
    "./testing": "./src/testing/SimulatedAccount.ts",
    "./adapters": "./src/adapters/index.ts",
    "./decode/x402": "./src/decode/x402.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai-agents",
    "erc-7579",
    "account-abstraction",
    "formal-verification",
    "policy",
    "safety"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "typecheck": "tsc --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "node scripts/publish-manifest.mjs",
    "postpack": "node scripts/publish-manifest.mjs restore",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {},
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  }
}
