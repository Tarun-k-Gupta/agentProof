# AgentProof environment.
#
# Every variable below is read by code. When one is added here it gets a
# consumer in the same change — an .env.example entry that nothing reads is
# worse than a missing one, because an operator sets it, sees no error, and
# believes a feature is on. LEDGER_APPROVAL_ENABLED was exactly that for a
# while: declared here, read nowhere, and silently meaning nothing.
#
# Grep check:  grep -rn "MY_VAR" packages/ apps/ scripts/ contracts/ recipes/

# ---- Mode -------------------------------------------------------------------
# simulation (default) runs in-process with no chain. production requires an
# RPC, a Graph endpoint, and non-zero deployed addresses; the API refuses to
# start otherwise rather than answering ALLOW against a hook that is not there.
AGENTPROOF_MODE=simulation
AGENTPROOF_POLICY=./agent.policy.json
PORT=8402

# ---- EVM (Sepolia) ----------------------------------------------------------
SEPOLIA_RPC_URL=
# ERC-4337 bundler for live UserOperations (e.g. Pimlico Sepolia endpoint).
# The pinned account is strict ERC-7579: execute() is onlyEntryPointOrSelf,
# so live traffic must go through the EntryPoint, never direct EOA calls.
BUNDLER_URL=
CHAIN_ID=11155111
USDC_ADDRESS=0x1c7d4b196cb0c7b01d743fbc6116a902379c7238

# The ONLY key the agent process gets. Scoped to the session validator.
AGENT_SESSION_KEY=
SMART_ACCOUNT_ADDRESS=

# The owner key lives in the approval service or on a Ledger, never in
# apps/agents — CI fails the build if that changes. scripts/demo-runner.ts
# reads it for the owner-approval scene; that is an operator's terminal, not
# the agent, and it is the one place it is allowed to appear.
OWNER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Set to true to run the demo against a live chain instead of the simulator.
# Incomplete configuration falls back to the simulator and says so.
AGENTPROOF_LIVE=false

# ---- ENSv2 (Sepolia) --------------------------------------------------------
# Beta contracts, explicitly not final. Whatever you use, record it in
# deployments/ensv2-sepolia.json.
ENS_UNIVERSAL_RESOLVER=

# Read by contracts/script/DeployEns.s.sol only.
ENS_REGISTRY_ADDRESS=
ENS_RESOLVER_ADDRESS=
AGENT_LABEL=trader
AGENT_SESSION_KEY_ADDRESS=
AGENT_POLICY_HASH=
AGENT_POLICY_HOOK_ADDRESS=

# ---- The Graph --------------------------------------------------------------
GRAPH_ENDPOINT=
GRAPH_API_KEY=
# Optional cross-protocol read: the deepest pool for a swap's pair is checked
# before the swap is allowed, using a second, public subgraph. Unset leaves the
# poolLiquidity policy unevaluated and the response says so.
UNISWAP_SUBGRAPH_ENDPOINT=
UNISWAP_MIN_POOL_TVL_USD=50000

# ---- Hedera / x402 ----------------------------------------------------------
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet
HEDERA_USDC_TOKEN_ID=
HCS_AUDIT_TOPIC_ID=

X402_ENABLED=false
# Blocky402 testnet base URL. The API calls /supported at boot and refuses to
# start if hedera-testnet with scheme=exact is not advertised.
X402_FACILITATOR_URL=
X402_SERVICE_URL=
X402_PRICE_VERIFY_USDC=0.01
X402_PRICE_DECODE_USDC=0.005

# ---- Verification API -------------------------------------------------------
API_PUBLIC_URL=
# Required for the dashboard. Without it the dashboard is unauthenticated and
# anyone who can reach the port can approve spending.
AGENTPROOF_ADMIN_TOKEN=

# ---- Dashboard --------------------------------------------------------------
AGENTPROOF_API_URL=http://127.0.0.1:8402
AGENT_NAME=trader.agentproof.eth

# ---- Agent model (optional; a scripted transcript is used when absent) -------
# OpenRouter is preferred when set; otherwise OPENAI_API_KEY (LangGraph).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Ledger (optional) ------------------------------------------------------
# true routes approvals to a connected device. If no device can be reached the
# process refuses to start rather than falling back to the dashboard — that
# fallback is a real downgrade and has to be a decision, not an error handler.
LEDGER_APPROVAL_ENABLED=false

# ---- Recipes / tooling ------------------------------------------------------
# scripts/capture-uniswap-fixtures.ts and scripts/verify-deployment.ts
V4_POOL_MANAGER=0xe03a1074c86cfedd5c142c4f04f1a1536e203543
# recipes/verify-before-you-swap.ts — optional token-risk metadata
TOKEN_RISK_API_URL=
