# ---- EVM (Sepolia) ----
SEPOLIA_RPC_URL=
BUNDLER_RPC_URL=                 # ERC-4337 bundler with 7579 account support
AGENT_SESSION_KEY=               # scoped key the agent signs with — the ONLY key the agent process gets
SMART_ACCOUNT_ADDRESS=
AGENT_POLICY_HOOK_ADDRESS=
USDC_ADDRESS=

# The owner key lives in the approval service or on the Ledger. It must never be
# readable from apps/agents — CI fails the build if it is.
OWNER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# ---- ENSv2 (Sepolia) ----
ENS_PARENT_NAME=agentproof.eth
AGENT_SUBNAME=trader.agentproof.eth
ENS_UNIVERSAL_RESOLVER=
ENS_REGISTRAR_ADDRESS=
ENS_RESOLVER_ADDRESS=

# ---- The Graph ----
GRAPH_ENDPOINT=                  # Subgraph Studio query URL
GRAPH_API_KEY=
UNISWAP_SUBGRAPH_ENDPOINT=

# ---- Hedera ----
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=              # ECDSA
HEDERA_NETWORK=testnet
HEDERA_USDC_TOKEN_ID=
X402_ENABLED=false
X402_FACILITATOR_URL=            # Blocky402 testnet base URL — verify /supported first
HCS_AUDIT_TOPIC_ID=

# ---- Verification API ----
API_PUBLIC_URL=
X402_PRICE_VERIFY_USDC=0.01
X402_PRICE_DECODE_USDC=0.005

# ---- Agent model (optional; a scripted transcript is used when absent) ----
OPENAI_API_KEY=

# ---- Ledger (optional) ----
LEDGER_APPROVAL_ENABLED=false
